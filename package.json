{
  "name": "pavio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && bash scripts/package.sh",
    "store:assets": "node scripts/make-store-assets.mjs && node scripts/make-privacy-html.mjs",
    "harness": "vite --config harness/vite.config.ts"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@preact/preset-vite": "^2.10.6",
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.4",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "preact": "^11.0.0"
  }
}
